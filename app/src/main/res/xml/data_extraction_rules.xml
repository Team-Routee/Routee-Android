<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- 서버 토큰은 기기 간 복원 시 만료 / 불일치 문제가 생기므로 백업하지 않는다 (core:data DataStoreModule) -->
    <!-- 운동 기록 DB, 지도 캡처, 운동 사진도 기기에서 진행 중인 기록이라 백업하지 않는다 (core:database DatabaseModule) -->
    <cloud-backup>
        <exclude domain="file" path="datastore/routee_token.preferences_pb" />
        <exclude domain="file" path="datastore/routee_permission.preferences_pb" />
        <exclude domain="database" path="routee.db" />
        <exclude domain="database" path="routee.db-wal" />
        <exclude domain="database" path="routee.db-shm" />
        <exclude domain="file" path="workout_map/" />
        <exclude domain="file" path="workout_photo/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/routee_token.preferences_pb" />
        <exclude domain="file" path="datastore/routee_permission.preferences_pb" />
        <exclude domain="database" path="routee.db" />
        <exclude domain="database" path="routee.db-wal" />
        <exclude domain="database" path="routee.db-shm" />
        <exclude domain="file" path="workout_map/" />
        <exclude domain="file" path="workout_photo/" />
    </device-transfer>
</data-extraction-rules>
